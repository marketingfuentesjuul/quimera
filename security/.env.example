# -----------------------------------------------------------------------------
# QUIMERA SITE - TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como '.env' en la raíz y rellena con valores reales.
# NUNCA subas el archivo '.env' real al repositorio en GitHub.
# -----------------------------------------------------------------------------

# Entorno de Ejecución (development, staging, production)
VITE_APP_ENV=development

# URL Base del Sitio
VITE_SITE_URL=https://quimerasite.cl

# Integraciones de Backend (si aplica, ej: Supabase)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Servidor de Correo o Servicio de Formularios (ej: EmailJS, Web3Forms, etc.)
VITE_CONTACT_FORM_API_KEY=your_form_service_key_here
VITE_RECEIVER_EMAIL=contacto@quimerasite.cl

# Google Analytics o Tags de Seguimiento (Opcional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
