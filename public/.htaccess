# -----------------------------------------------------------------------------
# QUIMERA SITE - CONFIGURACIÓN DE SEGURIDAD APACHE (SITEGROUND .htaccess)
# Copia el contenido de este archivo en el archivo '.htaccess' del directorio 
# principal ('public_html') de tu sitio web en SiteGround para activar seguridad.
# -----------------------------------------------------------------------------

# 1. FORZAR HTTPS (SSL) Y REDIRECCIÓN WWW
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Regla 1: Si no tiene WWW (y no es localhost ni IP local), redirigir a WWW con HTTPS
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Regla 2: Si tiene WWW pero no es HTTPS (y no es localhost ni IP local), redirigir a HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Soporte para Single Page Application (React Router)
    # Si el archivo o directorio solicitado no existe, redirigir todo a index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# 2. CABECERAS DE SEGURIDAD HTTP (SECURITY HEADERS)
<IfModule mod_headers.c>
    # Evita que el sitio sea enmarcado en otros dominios (Mitiga Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Protege contra vulnerabilidades de MIME-type sniffing (Fuerza la cabecera del servidor)
    Header set X-Content-Type-Options "nosniff"
    
    # Activa la protección contra XSS en navegadores legados
    Header set X-XSS-Protection "1; mode=block"
    
    # Fuerza al navegador a usar conexiones HTTPS únicamente (HSTS - 1 año)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Controla la información de referencia que se envía en enlaces externos
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restringe permisos del navegador para cámaras, micrófonos, etc. (Opcional y seguro)
    Header set Permission-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# 3. COMPRESIÓN GZIP (SPEED OPTIMIZATION)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 4. CACHÉ DEL NAVEGADOR (BROWSER CACHING)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. PREVENCIÓN DE NAVEGACIÓN DE DIRECTORIOS
Options -Indexes

# 6. DESHABILITAR FIRMAS DE SERVIDOR
ServerSignature Off

